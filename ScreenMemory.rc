// Ресурсы ScreenMemory.exe: две иконки (для ярлыков) и VERSIONINFO.
// Файл в UTF-8, поэтому сначала переключаем кодовую страницу — иначе кириллица
// в VERSIONINFO превратится в мусор.
#pragma code_page(65001)

#include "resource.h"
#include "src\version.h"

// Порядок важен: первая ICON-группа становится иконкой exe по умолчанию.
IDI_SAVE    ICON    "bin\\save.ico"
IDI_RESTORE ICON    "bin\\restore.ico"

1 VERSIONINFO
FILEVERSION     SM_VERSION_MAJOR,SM_VERSION_MINOR,SM_VERSION_PATCH,SM_VERSION_BUILD
PRODUCTVERSION  SM_VERSION_MAJOR,SM_VERSION_MINOR,SM_VERSION_PATCH,SM_VERSION_BUILD
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ScreenMemory"
            VALUE "FileDescription",  "ScreenMemory — сохранение и восстановление раскладки окон"
            VALUE "FileVersion",      SM_VERSION_FULL_WSTRING
            VALUE "InternalName",     "ScreenMemory"
            VALUE "LegalCopyright",   "© 2026"
            VALUE "OriginalFilename", "ScreenMemory.exe"
            VALUE "ProductName",      "ScreenMemory"
            VALUE "ProductVersion",   SM_VERSION_FULL_WSTRING
            VALUE "Comments",         "Слепок раскладки окон по виртуальным рабочим столам"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
